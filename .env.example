# Copie para .env.local e preencha.
# .env* esta no .gitignore — nada daqui vai para o repositorio.

# Neon: Dashboard > Project > Connection string (pooled)
# Formato: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Segredo usado para assinar o cookie de sessao do professor (Fase 3).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Codigo que uma pessoa precisa digitar para criar conta de professor pela
# tela de login (aba "Criar conta"). Combine com quem for usar o sistema —
# nao e para ficar publico. Sem esta variavel, o cadastro sempre recusa.
# Gere com: node -e "console.log(require('crypto').randomBytes(6).toString('base64url'))"
TEACHER_INVITE_CODE=

# URL publica da aplicacao. Usada para montar o link compartilhavel e o QR Code.
# Em desenvolvimento: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
